# local secrets (never commit) — e.g. ANTHROPIC_API_KEY for AI commentary
server/.env.local
.env.local

# --- DB + config backups (never versioned; lumi.db itself stays untracked) ---
lumi.db
lumi.db.bak*
*.bak_pre_*
*.bak

# --- nonrew-2 local deletion archive (uncommitted; the committed nonrew2_deleted_questions.json is the repo record) ---
nonrew2_local_archive/

# --- one-off / scratch scripts (root-level, not part of the app) ---
/apply_*.py
/audit_*.py
/dryrun_*.py
/capture_*.py

# --- exports / generated artifacts ---
*.xlsx
*.zip
*.png
/*.csv

# --- secrets (belt-and-braces; already ignored, keep explicit) ---
server/.env.local
.env*
.DS_Store

# --- machine-local tooling config (not product; keeps a per-machine permission allowlist) ---
.claude/settings.local.json
server/lumi.db

# --- identity store (Phase 1 split): pure PII, never versioned ---
identity.db
identity.db-wal
identity.db-shm
identity.db.bak*

# PH-LOG-1 (2026-08-03): defence in depth ONLY — the control is that no log is
# ever written inside the tree (run_gates refuses an in-tree workdir). Server
# logs carry console-emailed invite/reset links until D2 lands real delivery.
*.log
*.out
nohup.out
