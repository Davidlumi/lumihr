# Copy this file to ".env.local" (same folder) and fill in your key.
# .env.local is git-ignored and loaded automatically at server startup,
# so the AI commentary / board pack / Ask lumi run against the real Claude API.
#
#   cp server/.env.local.example server/.env.local
#   then edit server/.env.local and paste your key after the = sign
#
# Get a key at https://console.anthropic.com  (API keys -> Create Key)

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — pin a cheaper/different model (default is claude-opus-4-8):
# ANTHROPIC_MODEL=claude-sonnet-4-6
