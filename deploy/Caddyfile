# lumi production edge (R1a: Caddy fronting uvicorn, automatic ACME).
# TLS terminates here; uvicorn is loopback-only (systemd unit binds 127.0.0.1).
# Port 80 stays open ONLY for the ACME HTTP challenge + redirect — Caddy does
# both automatically for a site block named with a public hostname.
#
# THREE hostnames, one backend (2026-08-20, David: "nothing to do with Figma"):
#   lumihr.co.uk      -> the marketing site, served from web/*.html by this app
#   www.lumihr.co.uk  -> 301 to the apex, so there is one canonical address
#   app.lumihr.co.uk  -> the platform
# The marketing site used to be a Figma Sites property; both it and the apex
# were returning Cloudflare Error 1000 because Figma had never claimed the
# hostname. The pages already existed in this repo and were already being
# served, so the apex simply points here now. Cloudflare records for all three
# MUST stay grey (DNS only) — Caddy needs to answer the ACME challenge itself.

(lumi_common) {
	encode zstd gzip

	# Caching (2026-08-21): versioned assets (?v= bumped every release) live for a
	# year; marketing imagery a day (filenames are stable but occasionally
	# regenerated); HTML always revalidates — this is what makes deploys instant
	# and killed the stale-page cache we hit rebuilding the marketing site.
	@versioned path /static/css/* /static/js/* /static/vendor/*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@mkt path /static/mkt/*
	header @mkt Cache-Control "public, max-age=86400"

	reverse_proxy 127.0.0.1:8060 {
		# uvicorn sees the member's IP + original scheme
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- marketing -------------------------------------------------------------
lumihr.co.uk {
	import lumi_common

	log {
		output file /var/log/caddy/lumihr.co.uk.log {
			mode 0640
		}
	}
}

# one canonical address: www folds into the apex, preserving the path
www.lumihr.co.uk {
	redir https://lumihr.co.uk{uri} permanent
}

# --- the platform ----------------------------------------------------------
app.lumihr.co.uk {
	import lumi_common

	# Access logs: 0640 under /var/log/caddy (packaged default), no bearer
	# tokens ever appear in URLs by design (invite/reset tokens ride fragments
	# client-side: /app#/invite/<tok> — the fragment never reaches the server
	# log). Keep it that way: any new link format must keep tokens out of
	# paths and query strings.
	log {
		output file /var/log/caddy/app.lumihr.co.uk.log {
			mode 0640
		}
	}
}
