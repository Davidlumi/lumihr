# lumi production environment — copy to server/.env.local (git-ignored) and fill in.
# The server loads server/.env.local at startup; real environment variables win.
# Values marked (PROD) are asserted by the boot-time config validator when
# LUMI_BASE_URL is https:// — a misconfigured production instance refuses to start.

# ── Core ────────────────────────────────────────────────────────────────────
LUMI_BASE_URL=https://app.lumihr.co.uk        # (PROD) public origin; https for non-localhost. Drives Secure cookie + HSTS + link minting.

# ── Security (Cyber Essentials) ───────────────────────────────────────────────
LUMI_MFA=on                                    # (PROD) enforce email one-time-code MFA on every login (A7.16/A7.17). Requires SMTP below.
# LUMI_ALLOW_NO_MFA=on                          # deliberate override ONLY — lets prod boot without MFA. Do not use for a real launch.
# LUMI_SEED_DEMO must stay UNSET in production   # 'on' creates demo accounts with known passwords (A5.2/A5.3) — dev/QA only.
LUMI_SUPER_ADMINS=david@lumihr.co.uk           # back-office allowlist (comma-separated). Belt-and-braces over the platform_admin flag.
# LUMI_STAFF_PASSWORD=                          # initial password for seed_staff_admin.py; if unset a strong random one is generated + printed once.

# ── Email delivery (SES/SMTP) — required once MFA is on ───────────────────────
LUMI_SMTP_HOST=email-smtp.eu-west-2.amazonaws.com   # (PROD, if LUMI_MFA=on) unset ⇒ codes/invites/resets are console-logged, not sent.
LUMI_SMTP_PORT=587
LUMI_SMTP_USER=
LUMI_SMTP_PASS=
LUMI_SMTP_FROM=lumi <no-reply@lumihr.co.uk>

# ── AI Insights (dark at launch; turn on deliberately) ────────────────────────
LUMI_AI_INSIGHTS_ENABLED=off                   # master gate — all AI features off unless 'on'.
LUMI_AI_LIVE=off                               # paid Claude calls — deterministic drafts unless 'on'.
ANTHROPIC_API_KEY=                             # rotate before go-live; treat any key that has been in the working tree as compromised.
# ANTHROPIC_MODEL=claude-opus-4-8
# LUMI_AI_TIMEOUT_SECONDS=
# LUMI_BOARDPACK_PER_DAY=                       # per-org board-pack generation cap (cost control).
# LUMI_AI_DAILY_CALL_CAP=                       # global AI call/day kill-switch (cost control).

# ── Operations ────────────────────────────────────────────────────────────────
# LUMI_SIGNAL_SWEEP=on                          # nightly signal sweep + email digest (SINGLE instance only).
# LUMI_SWEEP_HOUR=7                             # sweep hour, UTC.
# WEB_CONCURRENCY must be 1                     # lumi assumes a single worker (in-memory rate limiter, scheduler, library cache).

# ── Data stores (defaults point at the repo/app dir; override for a deployed layout) ──
# LUMI_DB=/var/lib/lumi/lumi.db
# LUMI_IDENTITY_DB=/var/lib/lumi/identity.db
